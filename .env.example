# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://guardian:guardian_pass@localhost:5432/earlybird

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Slack ────────────────────────────────────────────────────────────────
# Set EITHER a bot token (enables real threaded enrichment replies via
# chat.postMessage) OR an incoming webhook URL (zero-OAuth, no native threading).
# If both are set, the bot token wins.
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_ALERT_CHANNEL=#earlybird-alerts

# Delivery reliability — the first (minimal) alert is retried before it is ever
# marked failed. The benchmark timestamp is set ONLY on a confirmed delivery.
SLACK_MAX_RETRIES=3
SLACK_RETRY_BACKOFF_SECONDS=0.5
SLACK_TIMEOUT_SECONDS=5.0

# Optional fallback notification targets (reserved; used only if Slack fails).
ALERT_FALLBACK_EMAIL=
PAGERDUTY_ROUTING_KEY=

# ─── Dashboard auth (set before exposing the dashboard publicly) ───────────
# When set, /dashboard/* requires header `x-dashboard-key: <this value>`.
DASHBOARD_API_KEY=

# ─── Freshdesk ────────────────────────────────────────────────────────────
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_POLL_INTERVAL_SECONDS=60
FRESHDESK_MATCH_WINDOW_HOURS=24
# Match tuning (knobs the matcher actually reads):
FRESHDESK_MATCH_TIME_WINDOW_MINUTES=1440     # 24h forward match window
FRESHDESK_MATCH_CONFIDENCE_THRESHOLD=0.5     # min hybrid confidence to record a match

# ─── Anthropic (Claude Haiku) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-haiku-4-5-20251001
# Enrichment runs AFTER the first alert; this only bounds the (later) LLM call.
LLM_ENRICHMENT_TIMEOUT_SECONDS=10.0

# PII hashing salt for user identifiers (keeps user refs non-PII but matchable).
USER_HASH_SALT=earlybird-default-salt-change-me

# ─── Webhook Secrets (set in production to authenticate inbound webhooks) ──
# Sentry uses HMAC (sentry-hook-signature header). The others use a shared
# secret sent as the `x-webhook-token` header. If left blank the endpoint is
# UNAUTHENTICATED (a warning is logged) — fine for local dev, not for prod.
SENTRY_WEBHOOK_SECRET=
DATADOG_WEBHOOK_SECRET=
PRODUCT_WEBHOOK_SECRET=
FRESHDESK_WEBHOOK_SECRET=

# ─── Scoring Thresholds ───────────────────────────────────────────────────
CRITICAL_SCORE_THRESHOLD=100
HIGH_SCORE_THRESHOLD=80
MEDIUM_SCORE_THRESHOLD=60
LOW_SCORE_THRESHOLD=40
DEDUP_WINDOW_MINUTES=30

# Alert decision thresholds:
INCIDENT_ALERT_THRESHOLD=60                  # default score needed to fire an alert
CRITICAL_BUSINESS_ACTION_THRESHOLD=40        # lower bar for /withdraw, /deposit, etc.

# ─── Anomaly Detection (catches silent business degradation) ───────────────
ANOMALY_Z_SCORE_THRESHOLD=3.0
ANOMALY_MIN_SAMPLE_SIZE=20
ANOMALY_CRITICAL_MIN_SAMPLE_SIZE=3           # smaller sample is meaningful for money actions
ANOMALY_BASELINE_WINDOW_MINUTES=60
ANOMALY_FAILURE_RATE_THRESHOLD=0.30
ANOMALY_PENDING_RATE_THRESHOLD=0.40
ANOMALY_LATENCY_REGRESSION_FACTOR=2.0
