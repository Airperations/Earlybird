# ─── App ──────────────────────────────────────────────────────────────────
APP_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://guardian:guardian_pass@localhost:5432/earlybird

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Slack ────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_ALERT_CHANNEL=#earlybird-alerts

# ─── Freshdesk ────────────────────────────────────────────────────────────
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key
FRESHDESK_POLL_INTERVAL_SECONDS=60
FRESHDESK_MATCH_WINDOW_HOURS=24

# ─── Anthropic (Claude Haiku) ─────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
LLM_MODEL=claude-haiku-4-5-20251001

# ─── Webhook Secrets (optional, for validation) ───────────────────────────
SENTRY_WEBHOOK_SECRET=
DATADOG_WEBHOOK_SECRET=

# ─── Scoring Thresholds ───────────────────────────────────────────────────
CRITICAL_SCORE_THRESHOLD=100
HIGH_SCORE_THRESHOLD=80
MEDIUM_SCORE_THRESHOLD=60
LOW_SCORE_THRESHOLD=40
DEDUP_WINDOW_MINUTES=30
